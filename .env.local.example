# =============================================================================
# MatchFIT — Environment variables template
# -----------------------------------------------------------------------------
# HOW TO USE:
#   1. Copy this file to `.env.local`   (cp .env.local.example .env.local)
#   2. Fill in the real values below.
#   3. Restart the dev server:          npm run dev
#
# NEVER commit `.env.local` — it holds real secrets. (It is already gitignored.)
# This template (.env.local.example) is safe to commit — it has placeholders only.
# =============================================================================

# --- Supabase (Database, Auth, Storage) ---
# From: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=      # the client-safe "anon"/public key
SUPABASE_SECRET_KEY=                  # server-only service key — NEVER expose in the browser

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # used by QR codes; set to your domain in production
ADMIN_EMAIL=

# --- Claude / Anthropic (AI ideation on the planning page) ---
# From: https://console.anthropic.com  ->  API Keys  (starts with sk-ant-...)
# Server-only — never exposed to the browser.
ANTHROPIC_API_KEY=
