{
  "name": "matchfit",
  "version": "2.0.0",
  "private": true,
  "description": "MatchFIT — Five-Pillar football programme: Supabase-backed site + PlayLab drill-design lab in one Next.js app.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
